# Copy to .env and fill in. .env is gitignored.
# Generate a key with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-50-char-random-secret
# DEBUG=True enables the dev server's static file serving (admin CSS/JS).
# Set DEBUG=False for production and serve static via WhiteNoise + collectstatic.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
